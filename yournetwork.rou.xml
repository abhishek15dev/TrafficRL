<?xml version="1.0" encoding="UTF-8"?>
<routes>

    <!-- Vehicle type -->
    <vType id="car"
           accel="1.5"
           decel="4.5"
           sigma="0.5"
           length="5"
           maxSpeed="10"/>

    <!-- Routes -->
    <route id="east_to_west" edges="east_center center_west"/>
    <route id="west_to_east" edges="west_center center_east"/>
    <route id="north_to_south" edges="north_center center_south"/>
    <route id="south_to_north" edges="south_center center_north"/>

    <!-- Vehicle flows (INTENTIONALLY IMBALANCED) -->
    <flow id="flow_north_to_south"
          route="north_to_south"
          begin="0" end="500"
          vehsPerHour="1200"/>

    <flow id="flow_south_to_north"
          route="south_to_north"
          begin="0" end="500"
          vehsPerHour="1200"/>

    <flow id="flow_east_to_west"
          route="east_to_west"
          begin="0" end="500"
          vehsPerHour="600"/>

    <flow id="flow_west_to_east"
          route="west_to_east"
          begin="0" end="500"
          vehsPerHour="600"/>

</routes>
